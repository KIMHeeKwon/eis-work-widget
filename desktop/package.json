{
  "name": "eis-work-widget",
  "version": "1.0.0",
  "description": "EIS 근무시간 데스크톱 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.js",
    "package": "node make-icon.js && electron-packager . \"EIS 근무시간 위젯\" --overwrite --platform=win32 --arch=x64 --icon=icon.ico --out=../dist --ignore=\"run.log\" --app-copyright=\"ETRI\" --app-version=1.0.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.1.1"
  }
}
